# Copy to .env.local and fill in from Supabase → Project Settings → API. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key_here

# Server-only (never prefix with NEXT_PUBLIC_). Set these in Vercel too.
SUPABASE_SECRET_KEY=sb_secret_from_supabase
CRON_SECRET=any-long-random-string
# League Gmail: the address and a Google "app password" (not the account password).
GMAIL_USER=league-address@gmail.com
GMAIL_APP_PASSWORD=sixteen-char-app-password
